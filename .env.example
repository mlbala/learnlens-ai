# Neon Postgres (pooled for app traffic; unpooled for migrations)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# Discrete PG vars (kept in sync with DATABASE_URL for tools that prefer them)
PGHOST=HOST-pooler.REGION.aws.neon.tech
PGDATABASE=neondb
PGUSER=neondb_owner
PGPASSWORD=
PGSSLMODE=require
PGCHANNELBINDING=require

# Neon branch + AI Gateway (filled by `neon deploy` / `neon env pull`)
NEON_BRANCH=production
NEON_BRANCH_ID=br-xxx
NEON_FUNCTION_HOST_SUFFIX=.compute.REGION.aws.neon.tech
NEON_AI_GATEWAY_BASE_URL=https://br-xxx-api.ai.REGION.aws.neon.tech
NEON_AI_GATEWAY_TOKEN=nt_live_...

# Qdrant Cloud (free tier) — do NOT run Qdrant in Docker.
# Create a cluster at https://cloud.qdrant.io → Cluster → copy
# the HTTPS endpoint as QDRANT_URL and an API key as QDRANT_API_KEY.
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.REGION.aws.cloud.qdrant.io
QDRANT_API_KEY=

REDIS_URL=redis://localhost:6379
AI_CHAT_PROVIDER=fake
AI_EMBED_PROVIDER=fake
OPENAI_API_KEY=
