# LearnLens AI — local environment template (placeholders only; never commit real secrets)
# Production-like deploy: see infra/deploy/DEPLOYMENT.md (operator permission required).
# Privacy / YouTube compliance: infra/deploy/PRIVACY_AND_COMPLIANCE.md
#
# --- Neon Postgres (free tier) ---
# 1. Create a project at https://console.neon.tech (no local Postgres/Docker volume).
# 2. Copy the pooled connection string into DATABASE_URL (app traffic).
# 3. Copy the direct (unpooled) string into DATABASE_URL_UNPOOLED (migrations, phase 02+).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# --- Qdrant Cloud (free tier) ---
# 1. Create a cluster at https://cloud.qdrant.io (do NOT run Qdrant in Docker).
# 2. Copy the HTTPS cluster URL and API key below.
# Capacity: ~0.5 vCPU / 1 GB RAM / 4 GB disk. Idle clusters may suspend (~1 week)
# and delete after ~4 weeks inactive — indexing/search fail closed when unreachable.
# QDRANT_VECTOR_STORE=memory for offline tests; qdrant for Cloud.
# QDRANT_DENSE_ONLY=true is an EXPLICIT feature flag (never silent hybrid fallback).
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.REGION.aws.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_VECTOR_STORE=qdrant
QDRANT_DENSE_ONLY=false
QDRANT_TOP_K=10
QDRANT_PREFETCH_LIMIT=40

# Local Redis (optional; enable with: docker compose --profile redis up -d)
REDIS_URL=redis://localhost:6379

# Exact-origin CORS allowlist for the browser → API path (comma-separated, no wildcards)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js server-side FastAPI base (used by /api/backend-health proxy; not NEXT_PUBLIC_*)
API_INTERNAL_URL=http://127.0.0.1:8000

# Web library data source: fixture (default demo, no YouTube key) or api (authenticated FastAPI)
# NEXT_PUBLIC_LIBRARY_MODE=fixture

# AI providers — keep fake for offline/dev until explicitly opting into live smoke
AI_CHAT_PROVIDER=fake
AI_CHAT_MODEL=fake-chat-v1
AI_EMBED_PROVIDER=fake
AI_EMBED_MODEL=fake-embed-v1
# 64 is fake-only. Real OpenAI/Gemini profiles must use vendor-verified dimensions.
AI_EMBED_DIMENSIONS=64
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=1800
AI_MAX_INPUT_CHARACTERS=120000
AI_MAX_RETRIES=2
# Allowlists are env-driven (comma-separated). Extend when enabling live models.
AI_CHAT_PROVIDER_ALLOWLIST=fake,openai,gemini,deepseek
AI_CHAT_MODEL_ALLOWLIST=fake-chat-v1
AI_EMBED_PROVIDER_ALLOWLIST=fake,openai,gemini
AI_EMBED_MODEL_ALLOWLIST=fake-embed-v1
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# App
ENVIRONMENT=development
LOG_LEVEL=INFO

# Auth / sessions (phase 02) — use a long random SESSION_SECRET in any shared environment
SESSION_SECRET=dev-only-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
# Omit COOKIE_SECURE to auto-enable Secure cookies outside development/test
COOKIE_SECURE=
COOKIE_SAMESITE=lax
AUTH_RATE_LIMIT_PER_MINUTE=20
# Broader API abuse limit (per client IP); auth uses AUTH_RATE_LIMIT_PER_MINUTE
API_RATE_LIMIT_PER_MINUTE=120
# Per-user daily caps (UsagePolicy) — process-local counters in MVP
USAGE_DAILY_CHAT_MESSAGES=200
USAGE_DAILY_TRANSCRIPT_JOBS=100
# Per-workspace period caps (usage_limits in Neon) — server-side enforcement
USAGE_WORKSPACE_JOBS_CAP=500
USAGE_WORKSPACE_TOKENS_CAP=2000000
USAGE_WORKSPACE_REQUESTS_CAP=10000
USAGE_WORKSPACE_SPEND_CAP_USD=25
# Structured JSON logs (phase 15). Set false for human-readable local dumps.
LOG_JSON=true
# Provider circuit breaker (timeouts / rate limits)
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RECOVERY_TIMEOUT_SECONDS=30
# Test-only fixture seeding — must stay false/unset in production
ALLOW_TEST_SEED=false

# YouTube Data API metadata (phase 04) — keep fake for offline/dev; no paid calls from defaults
YOUTUBE_METADATA_PROVIDER=fake
YOUTUBE_API_KEY=
YOUTUBE_REQUEST_TIMEOUT_SECONDS=20
YOUTUBE_MAX_RETRIES=2
YOUTUBE_METADATA_CACHE_TTL_SECONDS=300
YOUTUBE_PLAYLIST_PAGE_SIZE=50
YOUTUBE_PLAYLIST_MAX_ITEMS=200

# Transcript ingestion (phase 05) — local mock storage; Celery eager by default (no Redis required)
TRANSCRIPT_MAX_UPLOAD_BYTES=10485760
TRANSCRIPT_MAX_CHARACTERS=200000
TRANSCRIPT_STORAGE_BACKEND=local
TRANSCRIPT_STORAGE_PATH=.data/transcripts
TRANSCRIPT_JOB_MAX_ATTEMPTS=3
TRANSCRIPT_JOB_SOFT_TIME_LIMIT_SECONDS=120
TRANSCRIPT_JOB_TIME_LIMIT_SECONDS=180
CELERY_TASK_ALWAYS_EAGER=true
