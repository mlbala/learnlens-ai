      "video_id": "83158c49-a7d0-5134-ba86-722604cda82d",
      "workspace_id": "a06328a1-d1b3-512f-aa02-a2d5c98c2312",
      "ordinal": 1,
      "text": "Welcome to Python 101. Today we cover lists, aka dynamic arrays.",
      "start_ms": 1000,
      "end_ms": 5000,
      "source_revision": 1,
      "timecode_quality": "original",
      "youtube_video_id": "FxPyCourse01",
      "video_title": "Fixture: Python lists"
    },
    {
      "id": "742b963d-1e24-5212-a89a-c03dabeb5495",
      "video_key": "vid_py01",
      "video_id": "83158c49-a7d0-5134-ba86-722604cda82d",
      "workspace_id": "a06328a1-d1b3-512f-aa02-a2d5c98c2312",
      "ordinal": 2,
      "text": "Use append() to add one item. Prefer list comprehensions for transforms.",
      "start_ms": 5000,
      "end_ms": 10000,
      "source_revision": 1,
      "timecode_quality": "original",
      "youtube_video_id": "FxPyCourse01",
      "video_title": "Fixture: Python lists"
    },
    {
      "id": "60acbbca-fd04-5e84-9478-62042dd6301f",
      "video_key": "vid_py01",
      "video_id": "83158c49-a7d0-5134-ba86-722604cda82d",
      "workspace_id": "a06328a1-d1b3-512f-aa02-a2d5c98c2312",
      "ordinal": 3,
      "text": "Mutable default arguments are a common bug; use None and assign inside.",
      "start_ms": 10000,
      "end_ms": 15000,
      "source_revision": 1,
      "timecode_quality": "original",
      "youtube_video_id": "FxPyCourse01",
      "video_title": "Fixture: Python lists"
    },
    {
      "id": "6c1eda90-f687-5ff8-b2c1-506a286a00a4",
      "video_key": "vid_py01",
      "video_id": "83158c49-a7d0-5134-ba86-722604cda82d",
      "workspace_id": "a06328a1-d1b3-512f-aa02-a2d5c98c2312",
      "ordinal": 4,
      "text": "Big-O for append is amortized O(1). Indexing by position is O(1).",
      "start_ms": 15000,
      "end_ms": 20000,
      "source_revision": 1,
      "timecode_quality": "original",
      "youtube_video_id": "FxPyCourse01",
      "video_title": "Fixture: Python lists"
    },
    {
      "id": "754ebfc6-a407-533f-9ec7-50f9c1a7f504",
