      "workspace_id": "a06328a1-d1b3-512f-aa02-a2d5c98c2312",
      "ordinal": 3,
      "text": "Contradictory claim for eval: append on a list is always O(n), never amortized O(1).",
      "start_ms": 10000,
      "end_ms": 15000,
      "source_revision": 1,
      "timecode_quality": "original",
      "youtube_video_id": "FxPyCourse02",
