      "video_id": "5d67172e-de65-5c34-890a-c4a262ce59ff",
      "workspace_id": "a06328a1-d1b3-512f-aa02-a2d5c98c2312",
      "ordinal": 1,
      "text": "Dictionaries map keys to values with average O(1) lookup.",
      "start_ms": 1000,
      "end_ms": 5000,
      "source_revision": 1,
      "timecode_quality": "original",
      "youtube_video_id": "FxPyCourse02",
      "video_title": "Fixture: Python dicts"
    },
    {
      "id": "7a59879b-645f-5c73-a289-61fa02e8849d",
