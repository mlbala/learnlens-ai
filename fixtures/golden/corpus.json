      "workspace_id": "a06328a1-d1b3-512f-aa02-a2d5c98c2312",
      "ordinal": 3,
      "text": "Ask clarifying questions when a request is ambiguous.",
      "start_ms": 10000,
      "end_ms": 15000,
      "source_revision": 1,
      "timecode_quality": "original",
      "youtube_video_id": "FxCommGood01",
      "video_title": "Fixture: communication skills"
