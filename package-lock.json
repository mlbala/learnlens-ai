{
  "name": "learnlens-ai",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "learnlens-ai",
      "version": "0.0.0",
      "workspaces": [
        "apps/web",
        "packages/contracts"
      ],
      "engines": {
        "node": ">=20.19.0",
        "npm": ">=10.0.0"
      }
    },
    "apps/web": {
      "name": "@learnlens/web",
      "version": "0.0.0",
      "engines": {
        "node": ">=20.19.0",
        "npm": ">=10.0.0"
      }
    },
    "node_modules/@learnlens/contracts": {
      "resolved": "packages/contracts",
      "link": true
    },
    "node_modules/@learnlens/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/contracts": {
      "name": "@learnlens/contracts",
      "version": "0.0.0",
      "engines": {
        "node": ">=20.19.0"
